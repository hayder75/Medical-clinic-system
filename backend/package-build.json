    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pdfmake": "^0.2.20",
    "roboto-font": "^0.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "pkg": "^5.8.1"
