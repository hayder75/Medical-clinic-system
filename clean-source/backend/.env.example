# Database Configuration
# IMPORTANT: Replace YOUR_PASSWORD with your actual PostgreSQL password
# 
# Example: If your PostgreSQL password is "mypass123"
# Change this line to:
# DATABASE_URL="postgresql://postgres:mypass123@localhost:5432/clinicdb"
#
# Steps:
# 1. Copy this file and rename to .env
# 2. Open .env in Notepad
# 3. Find the line starting with DATABASE_URL
# 4. Replace YOUR_PASSWORD with your actual PostgreSQL password
# 5. Save the file
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/clinicdb?schema=public"

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret (Change this to a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# License Secret (Change this to a random string - min 32 characters)
LICENSE_SECRET=CHANGE_THIS_TO_YOUR_SECRET_KEY_MIN_32_CHARS

# Uploads Directory
UPLOADS_DIR=uploads

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
