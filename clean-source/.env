# Database Configuration
# This file will be automatically created by install-everything.bat
# with your PostgreSQL password
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/clinicdb?schema=public"

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# License Secret
LICENSE_SECRET=CHANGE_THIS_TO_YOUR_SECRET_KEY_MIN_32_CHARS

# Uploads Directory
UPLOADS_DIR=uploads

# Frontend URL
FRONTEND_URL=http://localhost:5173
